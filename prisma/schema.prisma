generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customers {
  id                String              @id @db.VarChar(10)
  name              String
  phone             String?             @db.VarChar(10)
  address           String
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  delivery_requests delivery_requests[]
}

model delivery_requests {
  id                                               String              @id @db.VarChar(10)
  request_number                                   String              @unique
  customer_id                                      String              @db.VarChar(10)
  item_description                                 String
  status                                           String?             @default("open")
  created_by                                       String              @db.VarChar(10)
  assigned_rider_id                                String?             @db.VarChar(10)
  created_at                                       DateTime?           @default(now()) @db.Timestamptz(6)
  users_delivery_requests_assigned_rider_idTousers users?              @relation("delivery_requests_assigned_rider_idTousers", fields: [assigned_rider_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_delivery_requests_created_byTousers        users               @relation("delivery_requests_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                                        customers           @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proof_of_delivery                                proof_of_delivery[]
  status_logs                                      status_logs[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model proof_of_delivery {
  id                  String            @id @db.VarChar(10)
  delivery_request_id String            @db.VarChar(10)
  recipient_name      String
  recipient_phone     String?           @db.VarChar(10)
  photo_url           String[]
  delivery_notes      String?
  created_at          DateTime?         @default(now()) @db.Timestamptz(6)
  delivery_requests   delivery_requests @relation(fields: [delivery_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model status_logs {
  id                  String            @id @db.VarChar(10)
  delivery_request_id String            @db.VarChar(10)
  previous_status     String?
  new_status          String
  changed_by          String            @db.VarChar(10)
  notes               String?
  created_at          DateTime?         @default(now()) @db.Timestamptz(6)
  users               users             @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delivery_requests   delivery_requests @relation(fields: [delivery_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model sync_events {
  id           String    @id @db.VarChar(10)
  entity_type  String
  entity_id    String    @db.VarChar(10)
  payload      Json
  is_processed Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                                           String              @id @db.VarChar(10)
  name                                                         String
  email                                                        String              @unique
  phone                                                        String?             @db.VarChar(10)
  role                                                         String
  is_active                                                    Boolean?            @default(true)
  created_at                                                   DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at                                                   DateTime?           @default(now()) @db.Timestamptz(6)
  delivery_requests_delivery_requests_assigned_rider_idTousers delivery_requests[] @relation("delivery_requests_assigned_rider_idTousers")
  delivery_requests_delivery_requests_created_byTousers        delivery_requests[] @relation("delivery_requests_created_byTousers")
  status_logs                                                  status_logs[]
}
